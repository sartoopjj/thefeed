# ============================================================
# thefeed-server — Docker Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----- Required -----

# Your DNS domain (e.g., t.example.com)
THEFEED_DOMAIN=t.example.com

# Encryption passphrase (shared between server and client)
THEFEED_KEY=your-secret-passphrase

# ----- Multi-domain (optional) -----
# Extra sub-domains the server also answers feed queries on, comma-separated.
# Clients spread queries across all of them (load distribution + resilience if
# one domain is filtered). The main domain above stays canonical for relay paths.
#THEFEED_EXTRA_DOMAINS=t2.example.com,t3.example.net

# ----- Feed integrity signing -----
# The server auto-generates an ed25519 signing key in its data dir on first run
# (no env var needed) and signs feed content so clients can verify integrity —
# important on public configs, where the passphrase is shared. Clients pin the
# public key via the sk= field of the import URI. Print the client config URI:
#   docker compose run --rm server --data-dir /data --print-config
# or just the public key:
#   docker compose run --rm server --data-dir /data --print-pubkey

# ----- Chat messenger (optional) -----
# A standalone end-to-end-encrypted messenger between thefeed users, served on
# its own dedicated sub-domain(s) (comma-separated, must differ from the feed
# domains). Empty/unset = messenger off. Requires feed integrity signing
# (clients only enable chat with a pinned sk= key). Limits are per user.
#THEFEED_CHAT_DOMAINS=c.example.com

# Turn chat off while keeping the domains configured (advertises "disabled"):
#THEFEED_CHAT_ENABLED=1
#THEFEED_CHAT_SEND_PER_HOUR=30
#THEFEED_CHAT_INBOX_CAP=50
#THEFEED_CHAT_PER_PAIR_CAP=10
#THEFEED_CHAT_MAX_MSG_BYTES=500

# Undelivered messages expire after this many hours:
#THEFEED_CHAT_TTL_HOURS=72

# Delete accounts idle this many days (0 = never; keeps reports accurate —
# raise only if a busy server needs to reclaim old accounts):
#THEFEED_CHAT_ACCOUNT_TTL_DAYS=0

# Cap total stored accounts (0 = unlimited):
#THEFEED_CHAT_MAX_ACCOUNTS=0

# How often to flush the message store to disk. 0 = fsync every message (max
# durability, lower throughput); N>0 = flush every N seconds (much higher
# throughput, a crash may lose up to ~N seconds of just-received messages —
# fine since chat is end-to-end encrypted and senders resend). Default 1.
#THEFEED_CHAT_SYNC_SECONDS=1

# ----- Paths and listening (all also available as flags) -----
# This file is read by the server itself, so it works however you start it:
#   ./thefeed-server                 reads ./.env
#   ./thefeed-server --data-dir X    also tries X/.env and X/thefeed.env
#   ./thefeed-server --env-file P    reads exactly P
#   docker compose up                reads it via env_file:
#   systemctl start thefeed-server   reads it via EnvironmentFile=
#
# Precedence, lowest to highest: this file < real environment variables <
# flags on the command line. So a variable already exported in your shell,
# or set by compose, always beats what is written here.
#THEFEED_DATA_DIR=./data
#THEFEED_LISTEN=0.0.0.0:53
#THEFEED_CHANNELS=./data/channels.txt
#THEFEED_PRIVATE_CHANNELS=./data/private_channels.txt
#THEFEED_X_ACCOUNTS=./data/x_accounts.txt
#THEFEED_SESSION=./data/session.json

# Public channels only, no Telegram login:
#THEFEED_NO_TELEGRAM=1

# The local web UI answers only at addresses this machine is reachable at
# (loopback, and whatever --host binds to), so a web page cannot re-point its
# own domain at the app and read your passphrase and messenger seed.
#
# Put any OTHER name you reach it by here, comma separated. You need this if:
#   - you put nginx/Caddy in front and it forwards the original name
#     (nginx: proxy_set_header Host $host;)
#   - you reach it by a hosts entry or a LAN DNS record
# You do NOT need it when the proxy sends the backend's own address instead
# (nginx's default with proxy_pass http://127.0.0.1:8080;).
#
# A refusal is logged with the exact name to add, so you do not have to guess.
#THEFEED_EXTRA_HOSTS=feed.example.com,feed.home.lan

# ----- MTProto tunnel / "Tel" tab (optional) -----
# Relays Telegram's own MTProto protocol over DNS, so the app can talk to real
# Telegram. Served on its own dedicated sub-domain(s) (comma-separated, must
# differ from the feed AND chat domains). Empty/unset = tunnel off.
# The relay only moves bytes: it never sees the user's Telegram auth key, and
# the tunnel's session keys live in a different key space from the messenger's.
#THEFEED_MTPROTO_DOMAINS=m.example.com

# Turn the tunnel off while keeping the domains configured (advertises
# "configured but disabled" so clients say so instead of probing):
#THEFEED_MTPROTO_ENABLED=1

# Cap on concurrently ACTIVE tunnels — one per connected user, never shared.
# Idle ones expire, so the number served over a day is far higher.
# 0 = uncapped; the process file-descriptor limit is then the real ceiling.
#THEFEED_MTPROTO_MAX_TUNNELS=0

# Expire a tunnel after N minutes with no cells (the client re-opens on next
# use, which costs a reconnect, not a fresh login):
#THEFEED_MTPROTO_IDLE_MINUTES=5

# Per-tunnel downstream buffer:
#THEFEED_MTPROTO_BUFFER_KB=32

# Per-tunnel downstream throttle in KB/minute. The relay carries encrypted
# bytes and cannot tell a message from a file, so volume is the only limit it
# can apply to a client that pulls downloads through it. 0 = uncapped.
#THEFEED_MTPROTO_DOWN_KB_PER_MIN=512

# Timeout when connecting to a Telegram data centre:
#THEFEED_MTPROTO_DIAL_SECONDS=15

# Dial Telegram's TEST data centres instead of production (development only):
#THEFEED_MTPROTO_TEST_DCS=0

# ----- Telegram Mode -----
# Default: --no-telegram (public channels only, no login needed)
# To use Telegram API, uncomment these AND remove --no-telegram from compose:

#TELEGRAM_API_ID=12345
#TELEGRAM_API_HASH=your-api-hash
#TELEGRAM_PHONE=+1234567890
#TELEGRAM_PASSWORD=your-2fa-password

# ----- Optional Settings -----

# Max messages per channel (default: 15)
#THEFEED_MSG_LIMIT=15

# Fetch cycle interval in minutes (min 3, default 10)
#THEFEED_FETCH_INTERVAL=10

# Allow remote channel management via DNS (default: disabled)
#THEFEED_ALLOW_MANAGE=0

# Nitter RSS instances for X/Twitter (comma-separated)
#THEFEED_X_RSS_INSTANCES=https://nitter.net,http://nitter.net

# Max random padding bytes in DNS responses (anti-DPI, default: 32)
#THEFEED_PADDING=32

# Log every decoded DNS query (default: disabled)
#THEFEED_DEBUG=0

# ----- Media Relays -----
# DNS relay (slow, works in censored networks). Default: off.
#THEFEED_DNS_MEDIA_ENABLED=1
#THEFEED_DNS_MEDIA_MAX_SIZE_KB=100
#THEFEED_DNS_MEDIA_CACHE_TTL_MIN=600
#THEFEED_DNS_MEDIA_COMPRESSION=gzip

# GitHub relay (fast, plain HTTPS). Default: off.
# Files are AES-256-GCM encrypted; folder + object names are HMAC'd
# with THEFEED_KEY so the public repo can't be linked back to your
# deployment. Needs a personal-access-token with contents:write.
#THEFEED_GITHUB_RELAY_ENABLED=1
#THEFEED_GITHUB_RELAY_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#THEFEED_GITHUB_RELAY_REPO=owner/repo
#THEFEED_GITHUB_RELAY_BRANCH=main
#THEFEED_GITHUB_RELAY_MAX_SIZE_KB=15360
#THEFEED_GITHUB_RELAY_TTL_MIN=600

# Repo size budget in GB, used to warn you as the repo fills. IMPORTANT: the
# relay only ever adds to git history, so deleting or pruning files does NOT
# reclaim space — the repo grows forever until GitHub refuses pushes with
# "Repository is above its size quota" (observed at ~100 GB). Warnings are
# logged at 70% and 90% and shown by `--report`; when it fills, delete the
# repo and create it again with the same name. The server detects the empty
# repo, resets its index, and re-uploads on demand. One repo per server.
#THEFEED_GITHUB_RELAY_QUOTA_GB=100

# Token note: a fine-grained token (github_pat_...) is scoped to a repository
# *ID*, so deleting and recreating the repo revokes its access even though the
# name is identical — re-grant the repo in the token settings afterwards. A
# classic token (ghp_... with the `repo` scope) covers all your repos and keeps
# working. Either way the server logs which case it hit.
